<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/dummy_paypal_saved_payment_method_logo"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:contentDescription="@string/paypal_saved_payment_method_label"
            android:src="@drawable/ic_paypal_brand_logo" />

        <TextView
            android:id="@+id/dummy_paypal_saved_payment_method_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/paypal_saved_payment_method_label"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dummy_paypal_saved_payment_method_funding_instrument"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="end"
            android:text="@string/dummy_paypal_saved_payment_method_funding_instrument" />

        <ImageView
            android:id="@+id/dummy_paypal_saved_payment_method_edit_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/paypal_saved_payment_method_edit_style_description"
            android:src="@drawable/ic_edit_pencil" />

    </LinearLayout>

    <TextView
        android:id="@+id/dummy_paypal_saved_payment_method_credit_messaging"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/dummy_paypal_saved_payment_method_credit_messaging"
        android:textSize="12sp" />

</merge>
